          ],
          "narration": "Three moves, and Muse Spark Open runs on your desk tonight. Eight hundred sixteen billion parameters. Your Mac hit its memory ceiling; tonight you go through it."
        },
        {
          "id": "s02",
          "role": "foreshadow",
          "est_duration_s": 11.0,
          "specific": true,
          "hits": [
            "num:about 493GB"
          ],
          "narration": "Quantization to four bits shrinks the weights. Even quartered, they take about four hundred ninety-three gigabytes of model weights. Add working memory and it tips past what one Studio holds. It does not fit."
        },
        {
          "id": "s03",
          "role": "explain",
          "est_duration_s": 13.5,
          "specific": true,
          "hits": [
            "entity:Mac"
          ],
          "narration": "Move one: cable the pair and switch on RDMA, remote direct memory access. One Mac writes straight into the other's memory. The wire is Thunderbolt Five, the port already on your Studio. Two cables double the bandwidth. macOS twenty six point two shipped it."
        },
        {
          "id": "s04",
          "role": "explain",
          "est_duration_s": 14.0,
          "specific": true,
          "hits": [
            "entity:Apple"
          ],
          "narration": "Move two: install the MLX build with JACCL. You want version zero point thirty point one or later. MLX is Apple's framework for models on Apple silicon. JACCL is the collectives layer: two Macs talking as one cluster."
        },
        {
          "id": "s05",
          "role": "explain",
          "est_duration_s": 15.0,
          "specific": true,
          "hits": [
            "entity:Muse Spark Open"
          ],
          "narration": "Move three: launch one command with a hostfile, a list of your two machines. It shards the model across both automatically. Tensor mode slices every layer, and both Macs compute each layer together, in sync. Muse Spark Open writes back at twenty four point nine nine tokens, word-pieces, a second."
        },
        {
          "id": "s06",
          "role": "explain",
          "est_duration_s": 9.0,
          "specific": true,
          "hits": [
            "entity:Mac"
          ],
          "narration": "Pipeline mode splits by depth, each Mac holding consecutive layers. Like an assembly line. Mistral Medium writes at the same speed on one Mac or two, pipelined."
        },
        {
          "id": "s07",
          "role": "explain",
          "est_duration_s": 8.5,
          "specific": true,
          "hits": [
            "entity:NVIDIA"
          ],
          "narration": "A real line fills up and gets faster; decode never does. Capacity, not speed. Same trick NVIDIA clusters have run for years. The desk cable is the new part."
        },
        {
          "id": "s08",
          "role": "payoff_close",
          "est_duration_s": 6.0,
          "specific": false,
          "hits": [],
          "narration": "The unit of local AI is no longer the machine. It is the desk."
        }
      ]
