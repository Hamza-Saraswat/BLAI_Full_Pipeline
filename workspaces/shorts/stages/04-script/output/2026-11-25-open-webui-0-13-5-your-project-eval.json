          "role": "explain",
          "est_duration_s": 11.0,
          "specific": true,
          "hits": [
            "entity:Machine"
          ],
          "narration": "Nothing here is free rein. The machine is a container you started, and the directory was picked once. Ask for approval, a per-chat mode, makes every tool call wait for your click."
        },
