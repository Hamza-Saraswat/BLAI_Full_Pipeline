# Binary per-run artifacts never enter git (text outputs are committed on purpose: they are the audit trail)
**/output/**/*.mp4
**/output/**/*.mov
**/output/**/*.wav
**/output/**/*.mp3
**/output/**/*.m4a
**/output/**/*.png
**/output/**/*.jpg
**/output/**/*.jpeg
**/output/**/*.gif
**/output/**/*.cast
**/output/**/scenes/
**/output/**/frames/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and caches
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.cache/
skills/render-shorts/**/node_modules/
skills/render-longform/**/node_modules/
skills/render-shorts/**/out/
skills/render-longform/**/out/
skills/render-shorts/**/media/

# Build agent runtime
build/logs/
build/state/
build/locks/

# Obsidian vault config lives outside git
.obsidian/

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.vscode/settings.json
.claude/settings.local.json

# Local test-run build artifacts (Kokoro voice, Mac renders)
.local-builds/
