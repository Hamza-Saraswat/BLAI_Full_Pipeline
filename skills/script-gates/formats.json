{
  "_doc": "Single source of truth for per-script-format bands (v2 port of pipeline/formats.json). Read by skills/script-gates/scripts/validate_storyboard.py and eval_short.py. classic values MUST render byte-identical validator/eval output for boards with no script_format key; change them only in lockstep with the baseline diffs. `structures` is informational: the narrative shape is independent of the band and the validator never rejects a value.",
  "default": "classic",
  "structures": ["worked-example", "myth-bust", "comparison-ladder", "news-react-so-what", "how-to-three-moves", "contrarian-take", "story-first", "number-first"],
  "formats": {
    "classic": {
      "label": "Classic",
      "blurb": "32-38s, ~85-110 words, dense and fast, first-person",
      "target_s": { "min": 28, "max": 60, "sweet_min": 32, "sweet_max": 38 },
      "words": { "min": 70, "max": 130, "hint": "~85-110" },
      "narration_max_chars": 1200,
      "scene_count": { "min": 3, "max": 7 },
      "scene_long_advisory_s": 12,
      "scene_narration_advisory_s": 13,
      "hook": { "concrete_required": true, "first_sentence_words": { "min": 5, "max": 12 }, "scene_max_s": 7 },
      "sentence": { "cap": 20, "pct_over_cap": 0.0, "avg_max": 15, "runaway": null },
      "numbers": { "policy": "spend", "min_count": 3, "ratio": 0.5 },
      "person": "we",
      "ending": "abrupt",
      "vo_band_s": { "min": 20, "max": 58 },
      "final_max_s": 60,
      "final_warn_s": { "min": 28, "max": 47 },
      "est_sum_tolerance": { "lo": 0.8, "hi": 1.25 },
      "wps_fallback": 2.6
    },
    "smooth-explainer": {
      "label": "Smooth explainer",
      "blurb": "75-150s, 250-450 words, one worked example in labelled stages, second person",
      "target_s": { "min": 60, "max": 180, "sweet_min": 75, "sweet_max": 150 },
      "words": { "min": 250, "max": 450, "hint": "~250-450" },
      "narration_max_chars": 3000,
      "scene_count": { "min": 5, "max": 12 },
      "scene_long_advisory_s": 16,
      "scene_narration_advisory_s": 16,
      "hook": { "concrete_required": false, "first_sentence_words": { "min": 5, "max": 14 }, "scene_max_s": 10 },
      "sentence": { "cap": 20, "pct_over_cap": 0.2, "avg_max": 16, "runaway": 28 },
      "numbers": { "policy": "cap", "max_count": 3 },
      "person": "you",
      "ending": "resolution-or-recap",
      "vo_band_s": { "min": 60, "max": 165 },
      "final_max_s": 180,
      "final_warn_s": { "min": 70, "max": 155 },
      "est_sum_tolerance": { "lo": 0.8, "hi": 1.25 },
      "wps_fallback": 3.35
    }
  }
}
