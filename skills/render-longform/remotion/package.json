{
  "name": "blai-longform",
  "version": "1.0.0",
  "description": "BLAI long-form episode renderer: Remotion 4 + React 19, 1920x1080 at 30 fps",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "browser": "remotion browser ensure",
    "render": "remotion render src/index.ts Episode out/final.mp4",
    "layout": "node scripts/layout.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "4.0.484",
    "@remotion/media-utils": "4.0.484",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
