# BLAI DGX Spark environment. Generated from the "DGX Spark" block of shared/env-template.md;
# keep the two in sync. build/install.sh copies this file to build/.env (mode 600) and fills the
# two BLAI_* paths. build/.env is gitignored: never commit it, never paste values into a note.
#
# Required before the build loop starts (install.sh and build.py check these):
#   BLOTATO_API_KEY BLOTATO_YOUTUBE_ACCOUNT_ID (voice keys optional: Chatterbox needs none)
#   TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
#   R2_BUCKET R2_PUBLIC_BASE_URL
# Optional: YT_API_KEY (analytics), ROUTINE_RESCRIPT_URL and ROUTINE_RESCRIPT_TOKEN (re-script
# button), ELEVEN_MODEL_ID, ELEVEN_SEED, BLAI_PUBLISH_PRIVACY.

ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL_ID=eleven_multilingual_v2
ELEVEN_SEED=4242
BLOTATO_API_KEY=
BLOTATO_YOUTUBE_ACCOUNT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blai-previews
R2_PUBLIC_BASE_URL=
YT_API_KEY=
ROUTINE_RESCRIPT_URL=
ROUTINE_RESCRIPT_TOKEN=
# Absolute paths (systemd does not expand $HOME). install.sh sets them: /srv/blai/... when sudo
# works, otherwise $HOME/blai/repo and $HOME/blai/builds.
BLAI_REPO_DIR=/srv/blai/repo
BLAI_BUILD_DIR=/srv/blai/builds
BLAI_PUBLISH_PRIVACY=private
