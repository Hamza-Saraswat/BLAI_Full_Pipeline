{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BLAI hub note frontmatter",
  "description": "Frontmatter of workspaces/<ws>/videos/<slug>.md. Flat scalars only so Obsidian Bases and tools/hubnote.py can read it without a YAML library.",
  "type": "object",
  "required": ["slug", "workspace", "status", "created", "updated"],
  "properties": {
    "slug": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$"},
    "workspace": {"enum": ["shorts", "long-form"]},
    "title": {"type": "string"},
    "status": {"enum": ["idea", "researched", "scripted", "ready-to-build", "building", "review", "approved", "rejected", "scheduled", "published", "blocked"]},
    "pillar": {"type": "string"},
    "series": {"type": "string"},
    "structure": {"type": "string"},
    "format": {"type": "string"},
    "style_pack": {"type": "string"},
    "value_types": {"type": "string"},
    "created": {"type": "string"},
    "updated": {"type": "string"},
    "publish_slot": {"type": "string"},
    "seo_score": {"type": ["integer", "number"]},
    "feedback": {"type": "string"},
    "blocked_reason": {"type": "string"},
    "build_host": {"type": "string"},
    "preview_url": {"type": "string"},
    "youtube_url": {"type": "string"},
    "blotato_post_id": {"type": "string"},
    "capture_window": {"type": "string"}
  }
}
