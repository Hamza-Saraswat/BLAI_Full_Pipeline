{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BLAI long-form spec",
  "description": "Scene list the long-form render stage compiles into a Remotion composition. The spec says what and when, never how (no component props, frame numbers or pixel positions).",
  "type": "object",
  "required": ["slug", "title", "target_duration_s", "chapters", "scenes", "thumbnail_concepts"],
  "properties": {
    "slug": {"type": "string"},
    "title": {"type": "string"},
    "target_duration_s": {"type": "integer", "minimum": 480, "maximum": 1200},
    "series": {"type": "string"},
    "chapters": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "required": ["label", "starts_at_scene"], "properties": {"label": {"type": "string"}, "starts_at_scene": {"type": "string"}}}
    },
    "scenes": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "type", "narration", "est_duration_s", "visual_intent"],
        "properties": {
          "id": {"type": "string", "pattern": "^s\\d{2,3}$"},
          "type": {"enum": ["title-card", "chapter-card", "kinetic-text", "code-typing", "terminal-replay", "diagram", "comparison-table", "chart", "stat-callout", "quote", "mascot-talk", "b-roll", "end-card"]},
          "narration": {"type": "string", "minLength": 1},
          "est_duration_s": {"type": "number", "minimum": 2},
          "visual_intent": {"type": "string", "description": "what a muted viewer should understand from this scene"},
          "on_screen_text": {"type": "array", "items": {"type": "string"}},
          "data": {"type": "object", "description": "scene-type specific content: code, rows, series, capture id, quote, etc."},
          "capture_ref": {"type": "string", "description": "id of a command in <slug>-experiment.md for terminal-replay scenes"},
          "sync_points": {"type": "array", "items": {"type": "object", "required": ["phrase", "event"], "properties": {"phrase": {"type": "string"}, "event": {"type": "string"}}}},
          "mood": {"type": "string"}
        }
      }
    },
    "thumbnail_concepts": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "required": ["words", "focus"], "properties": {"words": {"type": "string", "description": "at most 4 words"}, "focus": {"type": "string", "description": "the one object or number"}}}
    },
    "music_mood": {"type": "string"}
  }
}
